# temp / scratch
.agent-skills-tmp/
*.tmp
*.log

# automation marker files (RDP readiness gates, etc.)
.rdp-gate-ok
.rdp-gate-*

# upstream winapps clone (external dependency, pinned in winapps-baseline/README.md)
winapps-baseline/winapps/

# test artifacts - VM render captures + vms are disposable; native baseline is committed
winapps-baseline/captures/*
!winapps-baseline/captures/native/

# build artifacts
*.iso
*.qcow2
*.vdi
*.vmdk

# secrets - licenses/activations must never be committed
*.key
*.lic

# deploy: config locale e artefatti generati (segreti/chiavi restano fuori git)
deploy/.env
deploy/oem/office/configuration.xml
deploy/oem/office/odt-url.txt
deploy/oem/fonts/
deploy/shared/