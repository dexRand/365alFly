# pptx-open — configurazione dell'ambiente Windows+PowerPoint (dockur/windows).
#
# Copia in .env con:  scripts/pptx-deploy.sh init
# .env NON va committato (contiene credenziali e chiavi di licenza).
# Questo file è il template pubblico: qui nessun segreto reale.

# ---------------------------------------------------------------------------
# Credenziali account Windows (OBBLIGATORIE)
# Valgono per VNC web (porta 8006) e RDP.
# Solo caratteri alfanumerici: evita problemi di escaping in YAML/compose.
# ---------------------------------------------------------------------------
VM_USER=pptx
VM_PASSWORD=__GENERATE__

# ---------------------------------------------------------------------------
# Licenza Windows (opzionale)
# Vuoto = Windows non attivato (watermark tollerato in sviluppo).
# Con una product key acquistata, dockur la usa in install/activate.
# ---------------------------------------------------------------------------
WINDOWS_KEY=

# ---------------------------------------------------------------------------
# Licenza Office (necessaria per l'editing; senza, Office è in sola lettura)
#   OFFICE_EDITION:
#     auto     -> ltsc2024 se OFFICE_KEY è impostata, altrimenti o365 (trial)
#     ltsc2024 -> Office LTSC Professional Plus 2024 (Volume, auto-attiva con key)
#     ltsc2021 -> Office LTSC Professional Plus 2021 (Volume)
#     2019     -> Office Professional Plus 2019 (Volume)
#     o365     -> Microsoft 365 Apps for enterprise (attivazione via sign-in/trial)
#   OFFICE_KEY: product key 25 caratteri (xxxxx-xxxxx-xxxxx-xxxxx-xxxxx).
# ---------------------------------------------------------------------------
OFFICE_EDITION=auto
OFFICE_KEY=

# Lingua Office (en-us, it-it, ...; MatchOS = lingua del sistema Windows).
OFFICE_LANGUAGE=en-us
# App Office da NON installare (CSV di id ODT). Restano Word/Excel/PowerPoint.
OFFICE_EXCLUDE=Outlook,Teams,Groove,Access,Publisher,OneNote
# N = non installare Office affatto (solo Windows + desktop).
INSTALL_OFFICE=Y

# Office Deployment Tool (ODT). Link Microsoft: se scade, aggiornalo dal
# Download Center (id=49117) e incolla qui il nuovo URL.
ODT_URL=https://download.microsoft.com/download/6c1eeb25-cf8b-41d9-8d0d-cc1dbc032140/officedeploymenttool_20326-20112.exe

# ---------------------------------------------------------------------------
# Macchina virtuale
# ---------------------------------------------------------------------------
# 11l = Windows 11 LTSC 2024 (leggero, RDP stabile)
WINDOWS_VERSION=11l
WINDOWS_LANGUAGE=en-US
VM_RAM=6G
VM_CPU=4
VM_DISK=64G
DISPLAY_WIDTH=1600
DISPLAY_HEIGHT=900

# ---------------------------------------------------------------------------
# Rete / accesso (bind solo su loopback per default)
# ---------------------------------------------------------------------------
BIND_ADDR=127.0.0.1
WEB_PORT=8006
RDP_PORT=3389
VNC_PORT=5900
# Protegge la web UI (noVNC) con VM_USER/VM_PASSWORD.
# N (default): nessun login. Sicuro perché BIND_ADDR è solo loopback.
# Metti Y se esponi la VM in rete (cambi BIND_ADDR).
WEB_PROTECT=N

# ---------------------------------------------------------------------------
# Cartelle host
# SHARED_DIR = cartella condivisa con la VM (Z:\ e "Shared" sul desktop),
# bidirezionale: ci metti i file da aprire, ci ritrovi quelli salvati.
# Default ./shared (= deploy/shared): `prepare` vi copia anche i deck di test.
# Puoi puntarla a una tua cartella, assoluta o relativa a deploy/.
# ---------------------------------------------------------------------------
SHARED_DIR=./shared
