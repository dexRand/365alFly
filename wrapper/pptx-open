#!/usr/bin/env bash
# pptx-open — apre un .pptx con Microsoft PowerPoint REALE nella VM Windows.
#
# Modalità default: SEAMLESS (RDP RemoteApp/RAIL) -> PowerPoint appare come
# finestra nativa sul desktop Linux. Il file viene aperto direttamente dalla
# sua cartella (redirect `/drive:`), quindi non serve copia/sync: salvi e il
# file aggiornato è già quello sull'host.
#
# Modalità alternativa: `--vnc` -> apre nel desktop remoto e sincronizza
# tramite la cartella condivisa (utile se RAIL non funziona).
#
# Uso: pptx-open [--vnc] [--kill] [--status] FILE.pptx
set -Eeuo pipefail

SCRIPT_NAME="${0##*/}"
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
WRAPPER_DIR="$(cd -- "$(dirname -- "$SELF")" && pwd)"
ROOT_DIR="$(cd -- "$WRAPPER_DIR/.." && pwd)"
# shellcheck disable=SC1091  # path dinamico (ROOT_DIR); la lib è testata a parte
source "$ROOT_DIR/scripts/lib/pptx-common.sh"

DEPLOY_DIR="${PPTX_DEPLOY_DIR:-$ROOT_DIR/deploy}"
ENV_FILE="${PPTX_ENV_FILE:-$DEPLOY_DIR/.env}"
COMPOSE_FILE="${PPTX_COMPOSE_FILE:-$DEPLOY_DIR/compose.yaml}"
CONTAINER="${PPTX_CONTAINER:-pptx-open-windows}"
VM_HELPER_SRC="${PPTX_VM_HELPER_SRC:-$WRAPPER_DIR/vm/open-file.bat}"
DOCKER_BIN="${PPTX_DOCKER_BIN:-docker}"

# Client FreeRDP. Default xfreerdp3: wlfreerdp3 è deprecato e non gestisce
# /from-stdin (chiede la password a video). Override con PPTX_FREERDP_BIN.
FREERDP_BIN="${PPTX_FREERDP_BIN:-xfreerdp3}"

POWERPNT_WIN='C:\Program Files\Microsoft Office\root\Office16\POWERPNT.EXE'
MODE=rail
KILL=0
WAIT=1
TIMEOUT=1800

log() { printf '%s\n' "$*" >&2; }
die() { printf 'errore: %s\n' "$*" >&2; exit 1; }

# Accesso a docker: se il socket non è accessibile (utente non ancora nel
# gruppo `docker` dopo l'aggiunta) e `sudo -n` funziona, usa quello.
DOCKER=( "$DOCKER_BIN" )
if command -v "$DOCKER_BIN" >/dev/null 2>&1 \
   && ! "${DOCKER[@]}" info >/dev/null 2>&1 \
   && command -v sudo >/dev/null 2>&1 \
   && sudo -n "$DOCKER_BIN" info >/dev/null 2>&1; then
  DOCKER=( sudo -n "$DOCKER_BIN" )
fi

usage() {
  cat <<EOF
Uso: $SCRIPT_NAME [opzioni] FILE.pptx

Apre FILE.pptx in Microsoft PowerPoint reale nella VM Windows.
Default: seamless (finestra nativa su Linux via RDP RemoteApp).
Con --vnc: desktop remoto, con sincronizzazione via cartella condivisa.

Opzioni:
  --desktop        desktop Windows completo via RDP (fluido, una finestra)
  --vnc            desktop remoto VNC (con sincronizzazione cartella condivisa)
  --no-wait        (solo --vnc) apri e ritorna subito
  --kill           a fine sessione ferma la VM (disposable)
  --timeout SEC    (solo --vnc) attesa massima della chiusura (default 1800)
  --status         stato della VM
  -h, --help       questo messaggio

Config: $ENV_FILE
EOF
}

load_env() { pptx_load_env "$ENV_FILE"; }

compose_run() {
  if command -v "$DOCKER_BIN" >/dev/null 2>&1 && "${DOCKER[@]}" compose version >/dev/null 2>&1; then
    "${DOCKER[@]}" compose --env-file "$ENV_FILE" --file "$COMPOSE_FILE" "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose --env-file "$ENV_FILE" --file "$COMPOSE_FILE" "$@"
  else
    die "serve 'docker compose' (plugin) o 'docker-compose'"
  fi
}

vm_running() {
  "${DOCKER[@]}" ps -q --filter "name=^${CONTAINER}$" 2>/dev/null | grep -q .
}

ensure_vm() {
  vm_running && return 0
  log "VM non attiva: avvio ($CONTAINER)..."
  ( cd "$DEPLOY_DIR" && compose_run up -d )
  local deadline=$((SECONDS + 240))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if "${DOCKER[@]}" logs --tail 40 "$CONTAINER" 2>&1 | grep -q "Windows started successfully"; then
      break
    fi
    sleep 3
  done
  wait_guest_ready
}

# dockur segnala "Windows started successfully" appena parte QEMU, ma il
# desktop/RDP sono pronti ~30s dopo: attendere evita che il trigger a tastiera
# (o la connessione RDP) cada nel vuoto. La porta RDP è un buon indicatore che
# il sistema operativo è su. Override con PPTX_GUEST_READY_TIMEOUT.
wait_guest_ready() {
  local addr="${BIND_ADDR:-127.0.0.1}" port="${RDP_PORT:-3389}"
  local timeout="${PPTX_GUEST_READY_TIMEOUT:-180}" deadline
  [ "$addr" = "0.0.0.0" ] && addr="127.0.0.1"
  deadline=$((SECONDS + timeout))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if timeout 2 bash -c ": </dev/tcp/$addr/$port" 2>/dev/null; then
      sleep 2
      return 0
    fi
    sleep 2
  done
  log "attenzione: guest non pronto (RDP $addr:$port) entro ${timeout}s, procedo"
}

status() {
  load_env || die ".env non trovato ($ENV_FILE); esegui: scripts/pptx-deploy.sh init"
  local share; share="$(pptx_resolve_shared_dir "$DEPLOY_DIR" "${SHARED_DIR:-./shared}")"
  if vm_running; then
    log "VM: attiva ($CONTAINER)"
    "${DOCKER[@]}" ps --filter "name=^${CONTAINER}$" --format '    {{.Status}}'
  else
    log "VM: non attiva"
  fi
  log "Cartella condivisa: $share"
}

# --- Seamless (RAIL) --------------------------------------------------------

rail_open() {
  local file="$1" dir base addr port
  [ -f "$file" ] || die "file non trovato: $file"
  command -v "$FREERDP_BIN" >/dev/null 2>&1 || die "'$FREERDP_BIN' non trovato (installa freerdp)"
  load_env || die ".env non trovato ($ENV_FILE); esegui: scripts/pptx-deploy.sh init"

  addr="${BIND_ADDR:-127.0.0.1}"
  [ "$addr" = "0.0.0.0" ] && addr="127.0.0.1"
  port="${RDP_PORT:-3389}"
  dir="$(cd -- "$(dirname -- "$file")" && pwd)"
  base="$(basename -- "$file")"

  ensure_vm

  # L'app accede al file tramite il drive redirect `\\tsclient\pptxopen`.
  local app="program:$POWERPNT_WIN,file:\\\\tsclient\\pptxopen\\${base},name:PowerPoint"
  log "apro $base in PowerPoint (seamless). Chiudi la finestra per terminare."
  "$FREERDP_BIN" \
    /v:"${addr}:${port}" /u:"$VM_USER" /p:"$VM_PASSWORD" \
    /cert:ignore /sec:tls \
    /drive:pptxopen,"$dir" \
    "/app:$app" \
    /size:1280x800 +clipboard /sound
}

# --- Desktop RDP completo (fluido, una finestra) ----------------------------

desktop_open() {
  local file="$1" dir base addr port
  command -v "$FREERDP_BIN" >/dev/null 2>&1 || die "'$FREERDP_BIN' non trovato (installa freerdp)"
  load_env || die ".env non trovato ($ENV_FILE); esegui: scripts/pptx-deploy.sh init"
  addr="${BIND_ADDR:-127.0.0.1}"; [ "$addr" = "0.0.0.0" ] && addr="127.0.0.1"
  port="${RDP_PORT:-3389}"
  dir="$(cd -- "$(dirname -- "$file")" 2>/dev/null && pwd)" || dir="$(dirname -- "$file")"
  base="$(basename -- "$file")"

  ensure_vm
  log "apro il desktop Windows (RDP, fluido). Il file è raggiungibile dal drive 'pptxopen'."
  "$FREERDP_BIN" \
    /v:"${addr}:${port}" /u:"$VM_USER" /p:"$VM_PASSWORD" \
    /cert:ignore /sec:tls /dynamic-resolution \
    /drive:pptxopen,"$dir" +clipboard /sound \
    /wm-class:MicrosoftPowerPoint
}

# --- Desktop remoto VNC (fallback) ------------------------------------------

stage_file() {
  local share="$1" file="$2" base
  base="$(basename -- "$file")"
  mkdir -p "$share/inbox"
  cp -f "$file" "$share/inbox/$base"
  printf 'inbox\\%s\n' "$base" > "$share/request.txt"
  cp -f "$VM_HELPER_SRC" "$share/o.bat"
  rm -f "$share/done.txt"
}

trigger_helper() {
  # Lancia Z:\o.bat dal Run dialog. Il warning "Open File - Security Warning"
  # di ShellExecute sui .bat della condivisione viene soppresso da
  # `LowRiskFileTypes` impostato dal provisioning (deploy/oem/configure-trust.bat).
  # Non usare `cmd /c ...`: i comandi con spazi vengono dirottati
  # dall'autocomplete del Run dialog.
  # shellcheck disable=SC2016  # il codice perl è letterale, non deve espandersi
  "${DOCKER[@]}" exec "$CONTAINER" perl -MIO::Socket::UNIX -e '
    my $s = IO::Socket::UNIX->new(Peer => "/run/shm/monitor.sock") or die "monitor: $!\n";
    sub k { print $s "sendkey $_[0]\n"; select(undef,undef,undef,0.2); }
    print $s "sendkey meta_l-r\n"; select(undef,undef,undef,1.2);
    k($_) for ("shift-z","shift-semicolon","backslash","o","dot","b","a","t");
    k("ret");
    select(undef,undef,undef,3.0);
    k("alt-r");
    close $s;'
}

wait_done() {
  local share="$1" deadline=$((SECONDS + TIMEOUT))
  while [ ! -f "$share/done.txt" ]; do
    [ "$SECONDS" -ge "$deadline" ] && die "timeout: PowerPoint non ha chiuso entro ${TIMEOUT}s"
    sleep 2
  done
  grep -q '^ok' "$share/done.txt" || die "la VM ha segnalato un errore: $(cat "$share/done.txt")"
}

vnc_open() {
  local file="$1" share base
  [ -f "$file" ] || die "file non trovato: $file"
  load_env || die ".env non trovato ($ENV_FILE); esegui: scripts/pptx-deploy.sh init"
  share="$(pptx_resolve_shared_dir "$DEPLOY_DIR" "${SHARED_DIR:-./shared}")"

  ensure_vm
  stage_file "$share" "$file"
  trigger_helper
  log "PowerPoint aperto nella VM (VNC); chiudilo per sincronizzare."

  if [ "$WAIT" -eq 1 ]; then
    wait_done "$share"
    base="$(basename -- "$file")"
    cp -f "$share/inbox/$base" "$file"
    rm -f "$share/request.txt" "$share/done.txt" "$share/o.bat" "$share/inbox/$base"
    rmdir "$share/inbox" 2>/dev/null || true
    log "sincronizzato: $file"
  fi
}

# --- dispatch ---------------------------------------------------------------

main() {
  local file=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --desktop) MODE=desktop ;;
      --vnc)     MODE=vnc ;;
      --no-wait) WAIT=0 ;;
      --kill)    KILL=1 ;;
      --timeout) shift; [ "$#" -ge 1 ] || die "--timeout richiede un valore"; TIMEOUT="$1" ;;
      --status)  status; return 0 ;;
      -h|--help) usage; return 0 ;;
      --) shift; file="${1:-}"; break ;;
      -*) die "opzione sconosciuta: $1" ;;
      *) [ -z "$file" ] || die "troppi argomenti: $1"; file="$1" ;;
    esac
    shift
  done

  [ -n "$file" ] || { usage >&2; exit 2; }

  if [ "$MODE" = "vnc" ]; then
    vnc_open "$file"
  elif [ "$MODE" = "desktop" ]; then
    desktop_open "$file"
  else
    rail_open "$file"
  fi

  if [ "$KILL" -eq 1 ]; then
    log "fermo la VM (--kill)..."
    ( cd "$DEPLOY_DIR" && compose_run down )
  fi
}

main "$@"
